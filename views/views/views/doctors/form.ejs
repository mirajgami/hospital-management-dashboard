<div class="card-panel" style="max-width: 760px;">
  <h5><%= doctor ? 'Edit Doctor' : 'Add New Doctor' %></h5>

  <form action="<%= doctor ? '/doctors/' + doctor._id + '?_method=PUT' : '/doctors' %>" method="POST">
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label small fw-semibold">Full Name</label>
        <input type="text" name="name" class="form-control" value="<%= doctor ? doctor.name : '' %>" required>
      </div>
      <div class="col-md-6">
        <label class="form-label small fw-semibold">Specialization</label>
        <input type="text" name="specialization" class="form-control" placeholder="e.g. Cardiology" value="<%= doctor ? doctor.specialization : '' %>" required>
      </div>

      <div class="col-md-6">
        <label class="form-label small fw-semibold">Department</label>
        <input type="text" name="department" class="form-control" value="<%= doctor ? doctor.department : '' %>" required>
      </div>
      <div class="col-md-6">
        <label class="form-label small fw-semibold">Phone</label>
        <input type="text" name="phone" class="form-control" value="<%= doctor ? doctor.phone : '' %>" required>
      </div>

      <div class="col-md-6">
        <label class="form-label small fw-semibold">Email</label>
        <input type="email" name="email" class="form-control" value="<%= doctor ? doctor.email : '' %>" required <%= doctor ? 'readonly' : '' %>>
      </div>
      <div class="col-md-3">
        <label class="form-label small fw-semibold">Experience (yrs)</label>
        <input type="number" name="experienceYears" min="0" class="form-control" value="<%= doctor ? doctor.experienceYears : 0 %>">
      </div>
      <div class="col-md-3">
        <label class="form-label small fw-semibold">Consultation Fee</label>
        <input type="number" name="consultationFee" min="0" class="form-control" value="<%= doctor ? doctor.consultationFee : 0 %>">
      </div>

      <div class="col-md-8">
        <label class="form-label small fw-semibold">Available Days</label>
        <div class="d-flex flex-wrap gap-2">
          <% const days = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
             const selectedDays = doctor && doctor.availableDays ? doctor.availableDays : []; %>
          <% days.forEach(day => { %>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" name="availableDays" value="<%= day %>" id="day<%= day %>" <%= selectedDays.includes(day) ? 'checked' : '' %>>
              <label class="form-check-label small" for="day<%= day %>"><%= day %></label>
            </div>
          <% }) %>
        </div>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-semibold">Available Time</label>
        <input type="text" name="availableTime" class="form-control" placeholder="10:00 AM - 4:00 PM" value="<%= doctor ? doctor.availableTime : '' %>">
      </div>

      <% if (doctor) { %>
        <div class="col-md-4">
          <label class="form-label small fw-semibold">Status</label>
          <select name="status" class="form-select">
            <option value="active" <%= doctor.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= doctor.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
          </select>
        </div>
      <% } %>
    </div>

    <% if (!doctor) { %>
      <hr class="my-4">
      <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" name="createLogin" id="createLogin" onchange="document.getElementById('loginPasswordField').classList.toggle('d-none')">
        <label class="form-check-label small fw-semibold" for="createLogin">
          Create a login account for this doctor (role: doctor)
        </label>
      </div>
      <div id="loginPasswordField" class="d-none" style="max-width: 320px;">
        <label class="form-label small fw-semibold">Set Password</label>
        <input type="password" name="password" class="form-control" placeholder="Minimum 6 characters" minlength="6">
      </div>
    <% } %>

    <div class="mt-4 d-flex gap-2">
      <button type="submit" class="btn btn-hms-primary"><%= doctor ? 'Save Changes' : 'Add Doctor' %></button>
      <a href="/doctors" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div>
