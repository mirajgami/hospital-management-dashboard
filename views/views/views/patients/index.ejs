<div class="card-panel">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <form action="/patients" method="GET" class="d-flex" style="max-width: 320px;">
      <input type="text" name="q" value="<%= q %>" class="form-control form-control-sm me-2" placeholder="Search name, phone, email...">
      <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i></button>
    </form>
    <% if (['admin','receptionist'].includes(currentUser.role)) { %>
      <a href="/patients/new" class="btn btn-hms-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Patient</a>
    <% } %>
  </div>

  <% if (patients.length === 0) { %>
    <p class="text-muted small mb-0">No patients found.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-hms mb-0">
        <thead>
          <tr>
            <th>Name</th>
            <th>Age / Gender</th>
            <th>Phone</th>
            <th>Blood Group</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% patients.forEach(p => { %>
            <tr class="row-link" onclick="if(!event.target.closest('a,button,form')) window.location='/patients/<%= p._id %>'">
              <td><a href="/patients/<%= p._id %>" class="text-decoration-none fw-semibold"><%= p.name %></a></td>
              <td><%= p.age %> / <%= p.gender %></td>
              <td><%= p.phone %></td>
              <td><%= p.bloodGroup || '—' %></td>
              <td><span class="badge badge-status-<%= p.status %>"><%= p.status %></span></td>
              <td class="text-end">
                <a href="/patients/<%= p._id %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                <% if (['admin','receptionist'].includes(currentUser.role)) { %>
                  <a href="/patients/<%= p._id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                <% } %>
                <% if (currentUser.role === 'admin') { %>
                  <form action="/patients/<%= p._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Delete this patient record? This also removes their appointments.');">
                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
