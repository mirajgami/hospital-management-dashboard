<div class="row g-3">
  <div class="col-lg-4">
    <div class="card-panel">
      <div class="d-flex justify-content-between align-items-start">
        <h5 class="mb-0">Dr. <%= doctor.name %></h5>
        <span class="badge badge-status-<%= doctor.status %>"><%= doctor.status %></span>
      </div>
      <hr>
      <p class="mb-1 small"><strong>Phone:</strong> <%= doctor.phone %></p>
      <p class="mb-1 small"><strong>Email:</strong> <%= doctor.email %></p>
      <p class="mb-1 small"><strong>Experience:</strong> <%= doctor.experienceYears %> years</p>
      <p class="mb-1 small"><strong>Consultation Fee:</strong> ₹<%= doctor.consultationFee %></p>
      <p class="mb-1 small"><strong>Available Days:</strong> <%= doctor.availableDays.length ? doctor.availableDays.join(', ') : '—' %></p>
      <p class="mb-3 small"><strong>Available Time:</strong> <%= doctor.availableTime || '—' %></p>

      <% if (currentUser.role === 'admin') { %>
        <a href="/doctors/<%= doctor._id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil me-1"></i>Edit Doctor</a>
      <% } %>
    </div>

    <div class="card-panel mt-3">
      <h5><i class="bi bi-heart-pulse me-1"></i>Operations &amp; Specialization</h5>
      <p class="small mb-1"><strong>Department:</strong> <%= doctor.department %></p>
      <p class="small mb-0"><strong>Specializes in:</strong> <%= doctor.specialization %></p>
      <p class="text-muted small mt-2 mb-0">Patients are routed here by the AI Symptom Triage tool whenever a reason for visit matches this department.</p>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card-panel mb-3">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0"><i class="bi bi-calendar-check me-1"></i>Upcoming Patients</h5>
        <span class="badge bg-light text-dark border"><%= upcomingAppointments.length %> scheduled</span>
      </div>
      <% if (upcomingAppointments.length === 0) { %>
        <p class="text-muted small mb-0">No upcoming appointments scheduled.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hms mb-0">
            <thead>
              <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Patient</th>
                <th>Age / Gender</th>
                <th>Reason</th>
              </tr>
            </thead>
            <tbody>
              <% upcomingAppointments.forEach(a => { %>
                <tr class="row-link" onclick="if(!event.target.closest('a,button,form')) window.location='/patients/<%= a.patient._id %>'">
                  <td><%= new Date(a.date).toLocaleDateString() %></td>
                  <td><%= a.time %></td>
                  <td><a href="/patients/<%= a.patient._id %>" class="text-decoration-none fw-semibold"><%= a.patient ? a.patient.name : 'N/A' %></a></td>
                  <td><%= a.patient ? `${a.patient.age} / ${a.patient.gender}` : '—' %></td>
                  <td><%= a.reason || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="card-panel">
      <h5>Past / Completed Appointments</h5>
      <% if (pastAppointments.length === 0) { %>
        <p class="text-muted small mb-0">No past appointments recorded for this doctor.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hms mb-0">
            <thead>
              <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Patient</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% pastAppointments.forEach(a => { %>
                <tr>
                  <td><%= new Date(a.date).toLocaleDateString() %></td>
                  <td><%= a.time %></td>
                  <td><%= a.patient ? a.patient.name : 'N/A' %></td>
                  <td><span class="badge badge-status-<%= a.status %>"><%= a.status %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>
