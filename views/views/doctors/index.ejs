<div class="card-panel">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted small mb-0"><%= doctors.length %> doctor(s) on record</p>
    <% if (currentUser.role === 'admin') { %>
      <a href="/doctors/new" class="btn btn-hms-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Doctor</a>
    <% } %>
  </div>

  <% if (doctors.length === 0) { %>
    <p class="text-muted small mb-0">No doctors added yet.</p>
  <% } else { %>
    <div class="row g-3">
      <% doctors.forEach(d => { %>
        <div class="col-md-6 col-lg-4">
          <div class="border rounded-3 p-3 h-100 row-link" onclick="if(!event.target.closest('a,button,form')) window.location='/doctors/<%= d._id %>'">
            <div class="d-flex justify-content-between align-items-start mb-1">
              <h6 class="fw-bold mb-0"><a href="/doctors/<%= d._id %>" class="text-decoration-none text-dark">Dr. <%= d.name %></a></h6>
              <span class="badge badge-status-<%= d.status %>"><%= d.status %></span>
            </div>
            <p class="text-muted small mb-1"><%= d.specialization %> &middot; <%= d.department %></p>
            <p class="small mb-1"><i class="bi bi-telephone me-1"></i><%= d.phone %></p>
            <p class="small mb-2"><i class="bi bi-clock me-1"></i><%= d.availableTime || 'Not set' %></p>
            <div class="d-flex gap-2">
              <a href="/doctors/<%= d._id %>" class="btn btn-sm btn-outline-secondary flex-fill">View</a>
              <% if (currentUser.role === 'admin') { %>
                <a href="/doctors/<%= d._id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                <form action="/doctors/<%= d._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Remove this doctor?');">
                  <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
