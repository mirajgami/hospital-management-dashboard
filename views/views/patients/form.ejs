<div class="card-panel" style="max-width: 720px;">
  <h5><%= patient ? 'Edit Patient' : 'Register New Patient' %></h5>

  <form action="<%= patient ? '/patients/' + patient._id + '?_method=PUT' : '/patients' %>" method="POST">
    <div class="row g-3">
      <div class="col-md-8">
        <label class="form-label small fw-semibold">Full Name</label>
        <input type="text" name="name" class="form-control" value="<%= patient ? patient.name : '' %>" required>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-semibold">Age</label>
        <input type="number" name="age" min="0" max="130" class="form-control" value="<%= patient ? patient.age : '' %>" required>
      </div>

      <div class="col-md-4">
        <label class="form-label small fw-semibold">Gender</label>
        <select name="gender" class="form-select" required>
          <option value="">Select</option>
          <% ['Male','Female','Other'].forEach(g => { %>
            <option value="<%= g %>" <%= patient && patient.gender === g ? 'selected' : '' %>><%= g %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-semibold">Phone</label>
        <input type="text" name="phone" class="form-control" value="<%= patient ? patient.phone : '' %>" required>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-semibold">Blood Group</label>
        <input type="text" name="bloodGroup" class="form-control" placeholder="e.g. O+" value="<%= patient ? patient.bloodGroup : '' %>">
      </div>

      <div class="col-md-6">
        <label class="form-label small fw-semibold">Email (optional)</label>
        <input type="email" name="email" class="form-control" value="<%= patient ? patient.email : '' %>">
      </div>
      <div class="col-md-6">
        <label class="form-label small fw-semibold">Address</label>
        <input type="text" name="address" class="form-control" value="<%= patient ? patient.address : '' %>">
      </div>

      <div class="col-12">
        <label class="form-label small fw-semibold">Medical History</label>
        <textarea name="medicalHistory" rows="3" class="form-control" placeholder="Allergies, chronic conditions, past surgeries..."><%= patient ? patient.medicalHistory : '' %></textarea>
      </div>

      <% if (patient) { %>
        <div class="col-md-4">
          <label class="form-label small fw-semibold">Status</label>
          <select name="status" class="form-select">
            <option value="active" <%= patient.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="discharged" <%= patient.status === 'discharged' ? 'selected' : '' %>>Discharged</option>
          </select>
        </div>
      <% } %>
    </div>

    <div class="mt-4 d-flex gap-2">
      <button type="submit" class="btn btn-hms-primary"><%= patient ? 'Save Changes' : 'Register Patient' %></button>
      <a href="/patients" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div>
